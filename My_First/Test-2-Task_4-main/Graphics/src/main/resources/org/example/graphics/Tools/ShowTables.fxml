<?import javafx.scene.control.TextArea?>
<BorderPane xmlns="http://javafx.com/javafx/11"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="450.0" prefWidth="450.0">
    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 30;">
            <TextArea id = "text" prefWidth="300" prefHeight="300"/>

            <HBox spacing="20" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                <Button text="Закрыть" styleClass="btn-return" fx:id="close"
                        prefWidth="120" prefHeight="40"/>
            </HBox>







        </VBox>
    </center>
