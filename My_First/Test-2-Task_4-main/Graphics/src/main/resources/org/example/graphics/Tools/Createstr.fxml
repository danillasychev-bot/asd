<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>


<BorderPane xmlns="http://javafx.com/javafx/11"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@../Style.css"
            prefWidth="500" prefHeight="350">

    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 30;">

            <!-- Заголовок -->
            <Label text="Ввод строк в базу данных"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <!-- Первое текстовое поле -->
            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Первая строка (минимум 50 символов):"
                       style="-fx-font-size: 14px; -fx-text-fill: #34495e;"/>
                <TextField fx:id="str1"
                           promptText="Введите первую строку без пробелов"
                           styleClass="input-field"
                           prefWidth="400" prefHeight="35"/>
            </VBox>

            <!-- Второе текстовое поле -->
            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Вторая строка (минимум 50 символов):"
                       style="-fx-font-size: 14px; -fx-text-fill: #34495e;"/>
                <TextField fx:id="str2"
                           promptText="Введите вторую строку без пробелов"
                           styleClass="input-field"
                           prefWidth="400" prefHeight="35"/>
            </VBox>

            <!-- Кнопки -->
            <HBox spacing="20" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                <Button text="Сохранить" styleClass="btn-save" fx:id="save"
                        prefWidth="120" prefHeight="40"/>
                <Button text="Назад" styleClass="btn-return" fx:id="return"
                        prefWidth="120" prefHeight="40"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>