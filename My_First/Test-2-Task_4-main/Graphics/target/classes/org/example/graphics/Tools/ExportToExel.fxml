<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>


<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane xmlns="http://javafx.com/javafx/11"
            xmlns:fx="http://javafx.com/fxml/1"

            prefHeight="450.0" prefWidth="450.0">
    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 30;">


            <VBox spacing="5" alignment="CENTER">
                <Label text="Введите название файла Exel:"
                       style="-fx-font-size: 14px; -fx-text-fill: #34495e;"/>
                <TextField fx:id="text"
                           styleClass="input-field"
                           prefWidth="400" prefHeight="35"/>
            </VBox>

            <HBox spacing="100" alignment="CENTER" style="-fx-padding: 20 0 0 0;">

                <Button text="Сохранить" styleClass="btn-save" fx:id="save"
                        prefWidth="120" prefHeight="40"/>

                <Button text="Назад" styleClass="btn-return" fx:id="return"
                        prefWidth="120" prefHeight="40"/>

            </HBox>





        </VBox>
    </center>
</BorderPane>

